    background-image: url('/svg/wave.svg');
    background-size: cover;
    background-position: bottom;
    background-repeat: no-repeat;
  ">
          {dataItemCatalog.empresa.toLowerCase() ||
            dataItemCatalog.contacto.nombre}
        </h2>
        <div class=" text-base border-primary border-t-3 max-lg:border-b-3 my-1 flex-1 lg:flex lg:items-center lg:justify-center lg:flex-col">
          {dataItemCatalog.categoriaEmpresa.map((category) => (
            <p class="m-0">{category}</p>
          ))}
        </div>
      </div>
      <div class="lg:w-1/2  flex flex-col ">
