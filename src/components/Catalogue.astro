---
import type { CatalogItem } from "@/types/catalogue-types";
import { Icon } from "astro-icon/components";
import { DevToolbarTooltip } from "astro/runtime/client/dev-toolbar/ui-library/tooltip.js";

interface Props {
  data: CatalogItem[];
  totalPages: number;
}

const { data, totalPages } = Astro.props;
---

<div class="m-auto grid w-[min(100%,900px)] gap-10">
  {
    data.map((dataItemCatalog) => (
      <div class="container-card border-film-dark/25 relative flex min-h-[50dvh] w-full flex-col overflow-hidden border bg-white py-4 shadow-[0px_4px_16px_rgba(17,17,26,0.1),0px_8px_24px_rgba(17,17,26,0.1),0px_16px_56px_rgba(17,17,26,0.1)]">
        <div class="flex justify-between">
          <div class="border-film-dark flex w-[90%] flex-1 items-end border-b">
            <div class="font-headings bg-film-dark text-light flex w-[35%] justify-center px-4 py-6 font-extrabold uppercase">
              {dataItemCatalog.contacto.nombre}
            </div>
            <div class="font-headings text-primary-dark flex-1 text-right font-bold">
              {dataItemCatalog.categoriaEmpresa
                .slice(0, 2)
                .map((item, index) => (
                  <div class="text-right">
                    <span class="block">{item}</span>
                  </div>
                ))}
            </div>
            {dataItemCatalog.categoriaEmpresa.length > 2 && (
              <span class="text-primary-dark">...</span>
            )}
          </div>
          <div class="w-[10%]" />
        </div>
        <div class="flex w-[90%] flex-1 justify-between">
          <div class="flex flex-1">
            <div class="border-film-dark flex w-[35%] items-end justify-center border-r">
              <span class="button-card bg-ifef-dark text-light font-headings hover:bg-ifef cursor-pointer rounded-md px-4 py-2 font-bold transition duration-300">
                Proyectos
              </span>
            </div>
            <div class="flex w-[65%] items-end">
              <ul class="ml-4">
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="person" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.nombre.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="phone" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.telefonos.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="location" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.direccion.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="mail" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.email.toLowerCase()}
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="data-card bg-dark text-light fixed top-0 left-0 z-20 flex h-full min-h-screen w-full flex-col overflow-y-auto px-4 py-[calc(var(--header-height)+2rem)] opacity-0">
          <div class="cards-wrapper relative mx-auto space-y-16">
            <div class="highlight bg-light/15 absolute top-0 left-0 rounded-lg" />
            {dataItemCatalog.trabajosDestacados.map((item) => (
              <div class="card-inside relative rounded-lg px-4 py-8">
                <Icon
                  name="clapper"
                  class="clapper text-light pointer-events-none absolute right-6 bottom-6 h-[45px] w-[45px]"
                />
                <h3 class="title-card text-primary-dark title-card mb-4 leading-none">
                  {item.titulo}
                </h3>
                <div class="capitalize">{item.tipo.toLowerCase()}</div>
                <div class="capitalize">{item.pais.toLowerCase()}</div>
                <div class="capitalize">{item.anio}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .project {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      width: 75%;
      height: 2px;
      background: var(--color-film);
      bottom: 0;
      left: 12.5%;
    }
  }
  .project:last-child:before {
    display: none;
  }

  .card-inside {
    position: relative;
  }

  .clapper {
    transition: color 0.35s linear;
  }

  .clapper.is-hovered {
    color: var(--color-primary);
  }
</style>

<script>
  import gsap from "gsap";

  document.addEventListener("astro:page-load", () => {
    const containerCards =
      document.querySelectorAll<HTMLDivElement>(".container-card");

    containerCards.forEach((containerCard) => {
      const dataCard =
        containerCard.querySelector<HTMLDivElement>(".data-card");
      const buttonCard =
        containerCard.querySelector<HTMLDivElement>(".button-card");

      if (!dataCard || !buttonCard) return;

      buttonCard.addEventListener("click", () => {
        gsap.to(dataCard, {
          opacity: 1,
          onComplete: () => {
            gsap.set(dataCard, { pointerEvents: "auto" });
          },
        });
      });

      const highlight = dataCard.querySelector<HTMLDivElement>(".highlight");

      console.log({ highlight });

      const cardsWrapper =
        dataCard.querySelector<HTMLElement>(".cards-wrapper");
      if (!cardsWrapper) return;

      const cards = dataCard.querySelectorAll<HTMLElement>(".card-inside");

      cards.forEach((cardInside) => {
        const clapper = cardInside.querySelector<HTMLElement>(".clapper");
        if (!clapper) return;

        gsap.set(clapper, {
          rotation: 30,
          transformOrigin: "top left",
        });

        cardInside.addEventListener("mouseenter", () => {
          // Animación claqueta
          gsap.fromTo(
            clapper,
            { rotation: 30 },
            { rotation: 0, duration: 1.25, ease: "elastic.out(1, 0.4)" },
          );
          clapper.classList.add("is-hovered");

          // Mover highlight a este card
          const rect = cardInside.getBoundingClientRect();
          const wrapperRect = cardsWrapper.getBoundingClientRect();

          gsap.to(highlight, {
            opacity: 1,
            width: rect.width,
            height: rect.height,
            x: rect.left - wrapperRect.left,
            y: rect.top - wrapperRect.top,
            duration: 0.35,
            ease: "power2.out",
          });
        });

        cardInside.addEventListener("mouseleave", () => {
          // Animación claqueta de vuelta
          gsap.fromTo(
            clapper,
            { rotation: 0 },
            { rotation: 30, duration: 1, ease: "elastic.out(1, 0.4)" },
          );
          clapper.classList.remove("is-hovered");
        });
      });

      // Ocultar highlight cuando el ratón sale del contenedor completo
      dataCard.addEventListener("mouseleave", () => {
        gsap.to(highlight, {
          opacity: 0,
          duration: 0.25,
          ease: "power2.out",
        });
      });
    });
  });
</script>
