---
import type { CatalogItem } from "@/types/catalogue-types";
import { Icon } from "astro-icon/components";
import Wave from "@/assets/wave.svg";

interface Props {
  data: CatalogItem[];
  totalPages: number;
}

const { data, totalPages } = Astro.props;
---

<div class="m-auto grid w-[min(100%,900px)] gap-10">
  {
    data.map((dataItemCatalog) => (
      <div class="container-card border-film-dark/25 relative flex min-h-[50dvh] w-full flex-col overflow-hidden border py-4 shadow-[0px_4px_16px_rgba(17,17,26,0.1),0px_8px_24px_rgba(17,17,26,0.1),0px_16px_56px_rgba(17,17,26,0.1)]">
        <div class="flex justify-between">
          <div class="border-film-dark flex w-[90%] flex-1 items-end border-b">
            <div class="font-headings bg-film-dark text-light flex w-[35%] justify-center px-4 py-6 font-extrabold uppercase">
              {dataItemCatalog.contacto.nombre}
            </div>
            <div class="font-headings text-primary-dark flex-1 text-right font-bold">
              {/* 1. Slice the array to get only the first 3 items */}
              {dataItemCatalog.categoriaEmpresa
                .slice(0, 2)
                .map((item, index) => (
                  <div class="text-right">
                    <span class="block">{item}</span>
                  </div>
                ))}
            </div>
            {dataItemCatalog.categoriaEmpresa.length > 2 && (
              <span class="text-primary-dark">...</span>
            )}
          </div>
          <div class="w-[10%]" />
        </div>
        <div class="flex w-[90%] flex-1 justify-between">
          <div class="flex flex-1">
            <div class="border-film-dark flex w-[35%] items-end justify-center border-r">
              <span class="button-card bg-ifef-dark text-light font-headings hover:bg-ifef cursor-pointer rounded-md px-4 py-2 font-bold transition duration-300">
                Proyectos
              </span>
            </div>
            <div class="flex w-[65%] items-end">
              <ul class="ml-4">
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon
                      name="person"
                      class="text-primary-dark h-4 w-4"
                    />{" "}
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.nombre.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="phone" class="text-primary-dark h-4 w-4" />{" "}
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.telefonos.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon
                      name="location"
                      class="text-primary-dark h-4 w-4"
                    />{" "}
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.direccion.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="mail" class="text-primary-dark h-4 w-4" />{" "}
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.email.toLowerCase()}
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="data-card bg-film-dark text-light absolute inset-0 z-20 -translate-y-full overflow-y-scroll">
          Lorem ipsum dolor sit amet consectetur adipisicing elit. Velit, nobis
          eligendi tempore sint ea quos nesciunt tenetur maiores veniam, labore
          incidunt eaque tempora iste suscipit dignissimos asperiores
          laboriosam. Magnam, quae! Officia asperiores neque fuga qui fugiat id
          ullam accusamus fugit nemo, voluptates similique illo aut saepe magnam
          esse sed. Consequatur perspiciatis quos consectetur pariatur incidunt.
          Voluptatibus possimus quas molestiae sit! Autem repellendus excepturi
          asperiores porro, aliquam consequatur nam mollitia qui eos cumque
          minima voluptas blanditiis sapiente ipsum molestias doloremque
          adipisci fuga nesciunt neque nulla deserunt quidem numquam. Omnis, id
          sit. Similique consequuntur veritatis ad laudantium amet dolorem quas
          quaerat sed error maiores! Aperiam, natus. Sapiente exercitationem
          alias quo explicabo maiores consectetur sint placeat? Eum doloremque
          doloribus, ratione nobis fugit pariatur? Delectus temporibus incidunt
          corrupti beatae, doloribus, similique nostrum magnam necessitatibus
          fuga tempora aut nisi est repellat sequi distinctio nemo earum maxime
          possimus ipsum veniam mollitia eveniet reiciendis ducimus. Beatae,
          quod. Doloremque assumenda tenetur iste exercitationem inventore
          expedita, perspiciatis modi similique libero accusantium architecto
          culpa, sed ipsa quisquam eveniet nemo. Nesciunt quibusdam quidem ipsam
          vero fuga facere dignissimos, modi magnam alias. Explicabo, magni
          pariatur sed dolore vel obcaecati, optio, quas modi ea distinctio
          corrupti repellendus vitae atque quo tempora voluptas quod fuga
          perferendis ducimus doloremque incidunt qui consectetur cupiditate
          non. Inventore. Harum, atque? Molestiae autem, quasi asperiores ipsam
          doloribus quaerat aliquam dolor repudiandae sequi in ratione, ad, nam
          ullam minus enim vero laudantium nobis! Deleniti esse perferendis
          temporibus cupiditate, modi in?
        </div>
      </div>
    ))
  }
</div>

<style>
  .project {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      width: 75%;
      height: 2px;
      background: var(--color-film);
      bottom: 0;
      left: 12.5%;
    }
  }
  .project:last-child:before {
    display: none;
  }
</style>

<script>
  import gsap from "gsap";
  import Lenis from "lenis";

  document.addEventListener("astro:page-load", () => {
    const containerCard = document.querySelectorAll(
      ".container-card",
    ) as NodeListOf<HTMLDivElement>;

    containerCard.forEach((card) => {
      const dataCard = card.querySelector(".data-card") as HTMLDivElement;
      const buttonCard = card.querySelector(".button-card") as HTMLDivElement;

      buttonCard.addEventListener("click", () => {
        gsap.to(dataCard, { transform: "translateY(0)" });
      });

      // dataCard.addEventListener(
      //   "wheel",
      //   (e) => {
      //     e.stopPropagation();
      //     dataCard.scrollTop += e.deltaY;
      //   },
      //   { passive: true },
      // );
    });
  });
</script>
