---
import type { CatalogItem } from "@/types/catalogue-types";
import { Icon } from "astro-icon/components";

interface Props {
  data: CatalogItem[];
  totalPages: number;
}

const { data, totalPages } = Astro.props;
---

<div class="m-auto grid w-[min(100%,900px)] gap-10">
  {
    data.map((dataItemCatalog) => (
      <div class="container-card border-film-dark/25 relative flex min-h-[50dvh] w-full flex-col overflow-hidden border py-4 shadow-[0px_4px_16px_rgba(17,17,26,0.1),0px_8px_24px_rgba(17,17,26,0.1),0px_16px_56px_rgba(17,17,26,0.1)]">
        <div class="flex justify-between">
          <div class="border-film-dark flex w-[90%] flex-1 items-end border-b">
            <div class="font-headings bg-film-dark text-light flex w-[35%] justify-center px-4 py-6 font-extrabold uppercase">
              {dataItemCatalog.contacto.nombre}
            </div>
            <div class="font-headings text-primary-dark flex-1 text-right font-bold">
              {/* 1. Slice the array to get only the first 3 items */}
              {dataItemCatalog.categoriaEmpresa
                .slice(0, 2)
                .map((item, index) => (
                  <div class="text-right">
                    <span class="block">{item}</span>
                  </div>
                ))}
            </div>
            {dataItemCatalog.categoriaEmpresa.length > 2 && (
              <span class="text-primary-dark">...</span>
            )}
          </div>
          <div class="w-[10%]" />
        </div>
        <div class="flex w-[90%] flex-1 justify-between">
          <div class="flex flex-1">
            <div class="border-film-dark flex w-[35%] items-end justify-center border-r">
              <span class="button-card bg-ifef-dark text-light font-headings hover:bg-ifef cursor-pointer rounded-md px-4 py-2 font-bold transition duration-300">
                Proyectos
              </span>
            </div>
            <div class="flex w-[65%] items-end">
              <ul class="ml-4">
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon
                      name="person"
                      class="text-primary-dark h-4 w-4"
                    />{" "}
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.nombre.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="phone" class="text-primary-dark h-4 w-4" />{" "}
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.telefonos.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon
                      name="location"
                      class="text-primary-dark h-4 w-4"
                    />{" "}
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.direccion.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="mail" class="text-primary-dark h-4 w-4" />{" "}
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.email.toLowerCase()}
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <div class="data-card bg-dark text-light fixed top-0 left-0 z-20 flex h-full w-full flex-col items-center justify-center">
          <div class="space-y-16">
            {/* <Image src={Claqueta} alt="claqueta" /> */}
            {dataItemCatalog.trabajosDestacados.map((item) => (
              <div class="card-inside group relative">
                <Icon
                  name="clapper"
                  class="text-light-dark/10 group-hover:animate-wobble absolute right-0 bottom-0 h-[50px] w-[50px] rotate-18 duration-300"
                />
                <h3 class="text-primary-dark text-ne title-card mb-4 leading-none">
                  {item.titulo}
                </h3>
                <div class="capitalize">{item.tipo.toLowerCase()}</div>
                <div class="capitalize">{item.pais.toLowerCase()}</div>
                <div class="capitalize">{item.anio}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .project {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      width: 75%;
      height: 2px;
      background: var(--color-film);
      bottom: 0;
      left: 12.5%;
    }
  }
  .project:last-child:before {
    display: none;
  }

  .card-inside {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      height: 1px;
      background-color: var(--color-light);
    }
  }

  .card-inside {
    &:before {
      width: 50%;
      left: 50%;
      opacity: 0.3;
      transform: translateX(-50%);
      bottom: -2rem;
    }
  }
</style>

