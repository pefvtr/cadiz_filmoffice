              <>
                <span>
                  <Icon name="person" class="text-primary h-5 w-5" />{" "}
                </span>
                <p class="capitalize">
                  {dataItemCatalog.contacto.nombre.toLowerCase()}
                </p>
              </>
            </div>
            <div class="border-primary/25 flex items-center gap-3 border-b py-3">
              <>
                <span>
                  <Icon name="location" class="text-primary h-5 w-5" />
                </span>
                <p class="capitalize">
                  {dataItemCatalog.contacto.direccion.toLowerCase()}
                </p>
              </>
            </div>
            <div class="border-primary/25 flex items-center gap-3 border-b py-3">
              <>
                <span>
                  <Icon name="phone" class="text-primary h-5 w-5" />
