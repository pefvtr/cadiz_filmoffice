        </div>
        <div />
      </div>
    </div>
  ))
}

<style>
  .project {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      width: 75%;
      height: 2px;
      background: var(--color-film);
      bottom: 0;
      left: 12.5%;
    }
  }
  .project:last-child:before {
    display: none;
  }
</style>
