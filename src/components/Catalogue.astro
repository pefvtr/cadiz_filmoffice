---
import type { CatalogItem } from "@/types/catalogue-types";
import { Icon } from "astro-icon/components";

interface Props {
  data: CatalogItem[];
  totalPages: number;
}

const { data, totalPages } = Astro.props;
---

<div class="m-auto grid w-[min(100%,1440px)] gap-10 lg:grid lg:grid-cols-2 px-4">
  {
    data.map((dataItemCatalog) => (
      <div class="container-card group border-film-dark/25 relative flex min-h-[50dvh] w-full flex-col border bg-white py-4 shadow-[0px_4px_16px_rgba(17,17,26,0.1),0px_8px_24px_rgba(17,17,26,0.1),0px_16px_56px_rgba(17,17,26,0.1)] transition duration-300 hover:shadow-[-10px_-10px_30px_4px_rgba(202,99,4,0.12),10px_10px_30px_4px_rgba(202,99,4,0.18)]">
        {/* ── Cabecera de la card ── */}
        <div class="flex justify-between">
          <div class="border-film-dark  flex w-[95%] flex-1 items-end border-b">
            <div class="font-headings group-hover:bg-ifef-dark transition duration-300 bg-film-dark text-light group-hover:text-white flex w-[35%] justify-center px-4 py-6 font-extrabold uppercase">
              {dataItemCatalog.contacto.nombre}
            </div>

            <div class="categoria-wrapper font-headings text-primary-dark relative flex-1 text-right font-bold">
              {dataItemCatalog.categoriaEmpresa
                .slice(0, 2)
                .map((item, index) => (
                  <div class="text-right">
                    <span class="block">
                      {item}
                      {index === 1 &&
                        dataItemCatalog.categoriaEmpresa.length > 2 && (
                          <span class="text-primary-dark/50 cursor-default text-sm tracking-widest select-none">
                            {" "}
                            ...
                          </span>
                        )}
                    </span>
                  </div>
                ))}

              {dataItemCatalog.categoriaEmpresa.length > 2 && (
                <div class="categoria-tooltip pointer-events-none absolute right-0 bottom-full z-50 mb-2 min-w-max rounded bg-black px-3 py-2 text-left text-xs text-white opacity-0 shadow-lg">
                  {dataItemCatalog.categoriaEmpresa.slice(2).map((item) => (
                    <div class="py-0.5">• {item}</div>
                  ))}
                  <span class="absolute right-3 -bottom-1 h-2 w-2 rotate-45 bg-black" />
                </div>
              )}
            </div>
          </div>
          <div class="w-[5%]" />
        </div>

        {/* ── Cuerpo de la card ── */}
        <div class="flex w-[95%] flex-1 justify-between">
          <div class="flex flex-1">
            <div class="border-film-dark flex w-[35%] items-end justify-center border-r">
              <span class="button-card  bg-primary-dark text-white font-headings hover:bg-primary cursor-pointer rounded-md px-4 py-2 font-bold transition duration-300">
                Proyectos
              </span>
            </div>
            <div class="flex w-[65%] items-end">
              <ul class="ml-4">
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="person" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.nombre.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="phone" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.telefonos.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="location" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm capitalize">
                    {dataItemCatalog.contacto.direccion.toLowerCase()}
                  </span>
                </li>
                <li class="flex items-center gap-x-2">
                  <span>
                    <Icon name="mail" class="text-primary-dark h-4 w-4" />
                  </span>
                  <span class="text-sm">
                    {dataItemCatalog.contacto.email.toLowerCase()}
                  </span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        {/* ── Panel de proyectos (data-card) ── */}
        <div class="data-card bg-dark text-light pointer-events-none fixed top-0 left-0 z-1100 flex h-screen w-full flex-col overflow-hidden px-4 py-[calc(var(--header-height)+2rem)] opacity-0">
          <div class="close-data-card fixed top-6 right-6 z-1200 flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-white/20 bg-white/10 text-white transition-all hover:bg-white/30">
            <span class="pointer-events-none text-2xl leading-none font-light">
              &times;
            </span>
          </div>

          <div class="cards-wrapper relative mx-auto space-y-16">
            <div class="highlight bg-light/15 absolute top-0 left-0 rounded-lg" />
            {dataItemCatalog.trabajosDestacados.map((item) => (
              <div class="card-inside relative rounded-lg px-4 py-8">
                <Icon
                  name="clapper"
                  class="clapper text-light pointer-events-none absolute right-6 bottom-6 h-[45px] w-[45px]"
                />
                <h3 class="title-card text-primary-dark mb-4 leading-none">
                  {item.titulo}
                </h3>
                <div class="capitalize">{item.tipo.toLowerCase()}</div>
                <div class="capitalize">{item.pais.toLowerCase()}</div>
                <div class="capitalize">{item.anio}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

<style>
  .card-inside {
    position: relative;
  }

  .clapper {
    transition: color 0.35s linear;
  }

  .clapper.is-hovered {
    color: var(--color-primary);
  }
</style>

<script>
  import gsap from "gsap";
  import type Lenis from "lenis";

  // Helper para leer sin tocar window.lenis
  function getLenis(): Lenis | undefined {
    return (globalThis as any).__lenis__ as Lenis | undefined;
  }

  function closeDataCard(dataCard: HTMLDivElement) {
    gsap.to(dataCard, {
      opacity: 0,
      duration: 0.3,
      ease: "power2.inOut",
      onComplete: () => {
        dataCard.classList.remove("overflow-y-auto");
        dataCard.classList.add("overflow-hidden");
        gsap.set(dataCard, { pointerEvents: "none" });

        const originalParent = (dataCard as any)._originalParent as HTMLElement;
        if (originalParent && dataCard.parentElement === document.body) {
          originalParent.appendChild(dataCard);
        }

        dataCard.scrollTop = 0;

        document.body.style.overflow = "";
        getLenis()?.start(); // ✅ lectura
      },
    });
  }

  function setupDataCardInteractions(dataCard: HTMLDivElement) {
    const highlight = dataCard.querySelector<HTMLDivElement>(".highlight");
    const cardsWrapper = dataCard.querySelector<HTMLElement>(".cards-wrapper");
    const closeBtn = dataCard.querySelector<HTMLDivElement>(".close-data-card");

    if (!cardsWrapper || !highlight) return;

    closeBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      closeDataCard(dataCard);
    });

    const handleEscape = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        closeDataCard(dataCard);
        document.removeEventListener("keydown", handleEscape);
      }
    };
    document.addEventListener("keydown", handleEscape);

    const cards = dataCard.querySelectorAll<HTMLElement>(".card-inside");

    cards.forEach((cardInside) => {
      const clapper = cardInside.querySelector<HTMLElement>(".clapper");
      if (!clapper) return;

      gsap.set(clapper, {
        rotation: 30,
        transformOrigin: "top left",
      });

      cardInside.addEventListener("mouseenter", () => {
        gsap.fromTo(
          clapper,
          { rotation: 30 },
          { rotation: 0, duration: 1.25, ease: "elastic.out(1, 0.4)" },
        );
        clapper.classList.add("is-hovered");

        const rect = cardInside.getBoundingClientRect();
        const wrapperRect = cardsWrapper.getBoundingClientRect();

        gsap.to(highlight, {
          opacity: 1,
          width: rect.width,
          height: rect.height,
          x: rect.left - wrapperRect.left,
          y: rect.top - wrapperRect.top,
          duration: 0.3,
          ease: "power2.out",
        });
      });

      cardInside.addEventListener("mouseleave", () => {
        gsap.fromTo(
          clapper,
          { rotation: 0 },
          { rotation: 30, duration: 1, ease: "elastic.out(1, 0.4)" },
        );
        clapper.classList.remove("is-hovered");
      });
    });

    dataCard.addEventListener("mouseleave", () => {
      gsap.to(highlight, {
        opacity: 0,
        duration: 0.3,
        ease: "power2.out",
      });
    });
  }

  document.addEventListener("astro:page-load", () => {
    const containerCards =
      document.querySelectorAll<HTMLDivElement>(".container-card");

    containerCards.forEach((containerCard) => {
      const dataCard =
        containerCard.querySelector<HTMLDivElement>(".data-card");
      const buttonCard =
        containerCard.querySelector<HTMLDivElement>(".button-card");

      if (!dataCard || !buttonCard) return;

      (dataCard as any)._originalParent = containerCard;

      buttonCard.addEventListener("click", () => {
        document.body.appendChild(dataCard);
        dataCard.classList.remove("overflow-hidden");
        dataCard.classList.add("overflow-y-auto");

        document.body.style.overflow = "hidden";
        getLenis()?.stop(); // ✅ lectura

        gsap.to(dataCard, {
          opacity: 1,
          duration: 0.3,
          ease: "power2.out",
          onComplete: () => {
            gsap.set(dataCard, { pointerEvents: "auto" });
            setupDataCardInteractions(dataCard);
          },
        });
      });

      const categoriaWrapper =
        containerCard.querySelector<HTMLElement>(".categoria-wrapper");
      const tooltip =
        categoriaWrapper?.querySelector<HTMLElement>(".categoria-tooltip");

      if (categoriaWrapper && tooltip) {
        categoriaWrapper.addEventListener("mouseenter", () => {
          gsap.killTweensOf(tooltip);
          tooltip.classList.remove("pointer-events-none");
          gsap.fromTo(
            tooltip,
            { opacity: 0, y: 6 },
            { opacity: 1, y: 0, duration: 0.3, ease: "power2.out" },
          );
        });

        categoriaWrapper.addEventListener("mouseleave", () => {
          gsap.killTweensOf(tooltip);
          gsap.to(tooltip, {
            opacity: 0,
            y: 6,
            duration: 0.15,
            onComplete: () => tooltip.classList.add("pointer-events-none"),
          });
        });
      }
    });
  });
</script>
