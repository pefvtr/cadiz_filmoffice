---
import type { CatalogItem } from "@/types/catalogue-types";
import { Icon } from "astro-icon/components";

interface Props {
  data: CatalogItem[];
  totalPages: number;
}

const { data, totalPages } = Astro.props;
---

<div class="m-auto grid w-[min(100%,480px)] gap-10">
  {
    data.map((dataItemCatalog) => (
      <div class="min-h-[30dvh] shadow-[0px_4px_16px_rgba(17,17,26,0.1),_0px_8px_24px_rgba(17,17,26,0.1),_0px_16px_56px_rgba(17,17,26,0.1)]">
        <div class=""></div>
      </div>
    ))
  }
</div>

<style>
  .project {
    position: relative;
    &:before {
      content: "";
      position: absolute;
      width: 75%;
      height: 2px;
      background: var(--color-film);
      bottom: 0;
      left: 12.5%;
    }
  }
  .project:last-child:before {
    display: none;
  }
</style>

