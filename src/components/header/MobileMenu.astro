---
import { Icon } from "astro-icon/components";
import { menuItems, phrases } from "@/components/header/data";

const currentPath = Astro.url.pathname;
---

<div
  class="menu-overlay fixed top-0 left-0 h-screen w-full overflow-hidden bg-[#0f0f0f] [clip-path:polygon(0%_0%,100%_0%,100%_0%,0%_0%)]"
>
  <div
    class="menu-content transform:[translateX(-100px)] transform:[translateY(-100px)] relative flex h-full w-full origin-bottom-left scale-150 rotate-[-15deg] flex-col items-center justify-center"
  >
    <div
      class="menu-socials absolute top-9 left-2 flex -translate-y-[50%] gap-2 lg:left-4"
    >
      <div
        class="social-icon hover:text-primary text-white opacity-0 transition-colors duration-300"
      >
        <Icon name="in" class="h-6 w-6" />
      </div>
      <div
        class="social-icon hover:text-primary text-white opacity-0 transition-colors duration-300"
      >
        <Icon name="x" class="h-6 w-6" />
      </div>
    </div>
    <div class="menu-items flex flex-1 flex-col items-center justify-center">
      <div class="col-image">imagen</div>
      <div class="col-nav">
        <nav class="menu-links flex flex-col">
          {
            menuItems.map((item) => (
              <a
                class:list={[
                  "parent relative overflow-hidden",
                  { "!pointer-events-none": currentPath === item.url },
                ]}
                href={item.url}
              >
                <h2 class="text-primary clip font-headings relative z-10 px-2">
                  {item.label}
                </h2>
                <h2 class="font-headings absolute top-0 left-0 px-2 text-white">
                  {item.label}
                </h2>
              </a>
            ))
          }
        </nav>
      </div>
    </div>
    <div
      class="menu-footer relative mb-12 w-full overflow-hidden leading-none opacity-0"
    >
      {
        phrases.map((phrase) => (
          <h3
            class:list={[
              "text-center text-base text-white sm:text-lg",
              {
                "absolute top-0 left-0 w-full translate-y-[105%]":
                  phrase.id !== 1,
              },
            ]}
          >
            {phrase.text}
          </h3>
        ))
      }
    </div>
  </div>
</div>

<style>
  .clip {
    clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
    will-change: clip-path;
    pointer-events: none; /* MUY IMPORTANTE */
  }
</style>

<script>
  import gsap from "gsap";
  import { isMenuOpenStore } from "@/stores/menu";

  document.addEventListener("astro:page-load", () => {
    const parents = document.querySelectorAll(
      ".parent",
    ) as NodeListOf<HTMLElement>;

    parents.forEach((parent) => {
      const clip = parent.querySelector(".clip") as HTMLElement;

      isMenuOpenStore.subscribe((value) => {
        if (value) {
          console.log("Menu opened - enabling pointer events");
          parent.style.pointerEvents = "auto";
        } else {
          console.log("Menu closed - disabling pointer events");
          parent.style.pointerEvents = "none";
        }
      });

      parent.addEventListener("mouseenter", () => {
        // gsap.killTweensOf(clip);
        gsap.fromTo(
          clip,
          {
            clipPath: "polygon(0 0, 0 0, 0 100%, 0 100%)",
            duration: 0.4,
            ease: "power2.out",
          },
          {
            clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
          },
        );
      });

      parent.addEventListener("mouseleave", () => {
        // gsap.killTweensOf(clip);
        gsap.fromTo(
          clip,
          {
            clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)",
            duration: 0.4,
            ease: "power2.in",
          },
          {
            clipPath: "polygon(100% 0, 100% 0, 100% 100%, 100% 100%)",
          },
        );
      });
    });
  });
</script>
