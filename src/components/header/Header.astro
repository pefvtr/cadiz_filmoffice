---
import Logo from "@/components/Logo.astro";
import MobileNavigation from "@/components/header/MobileNavigation.astro";
import DesktopNavigation from "@/components/header/DesktopNavigation.astro";
---

<header
  id="main-header"
  class="fixed top-0 left-1/2 z-50 flex h-(--header-height) w-full max-w-7xl -translate-x-1/2 items-center justify-center gap-2 rounded-md bg-white/70 shadow-lg backdrop-blur-sm"
>
  <div
    class="horizontal-bar-menu bg-primary absolute bottom-1 h-[3px] w-[min(35%,200px)] cursor-pointer rounded-full"
  >
  </div>
  <div class="flex w-full max-w-7xl items-center justify-between px-2 md:px-4">
    <Logo classNames="w-28 sm:w-32 pl-2 sm:pl-4" />
    <MobileNavigation classNames="lg:hidden" />
    <DesktopNavigation />
  </div>
</header>
