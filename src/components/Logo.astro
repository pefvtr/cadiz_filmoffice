---
import LogoSVG from "@/assets/logo-ifef.png";
import { Image } from "astro:assets";

interface Props {
  classNames?: string;
}

const { classNames = "" } = Astro.props;
---

<div class:list={["", classNames]}>
  <a href="/">
    <Image src={LogoSVG} alt="Logo Cádiz Film Office" />
  </a>
</div>
