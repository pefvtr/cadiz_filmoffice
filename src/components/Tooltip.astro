---
import type { Placement } from "@floating-ui/dom";

interface Props {
  text?: string;
  placement?: Placement;
  offset?: number;
  tooltipClass?: string;
}

const {
  text = "",
  placement = "top",
  offset = 8,
  tooltipClass = "",
} = Astro.props;
---

<span class="tooltip-wrapper relative inline-block">
  <slot />
  <span
    class={`tooltip pointer-events-none absolute z-50 text-justify opacity-0 ${tooltipClass}`}
    data-placement={placement}
    data-offset={offset}
  >
    {text}
    <span
      class="tooltip-arrow absolute h-2 w-2 rotate-45 border-r border-b bg-inherit"
    ></span>
  </span>
</span>

<script>
  import {
    computePosition,
    offset as offsetMiddleware,
    flip,
    shift,
    arrow,
    autoUpdate,
    type Placement,
  } from "@floating-ui/dom";
  import gsap from "gsap";

  function initTooltips() {
    const wrappers = document.querySelectorAll<HTMLElement>(".tooltip-wrapper");

    wrappers.forEach((wrapper) => {
      // Evitar doble inicialización
      if (wrapper.dataset.tooltipInit === "true") return;
      wrapper.dataset.tooltipInit = "true";

      // El trigger es el primer hijo directo (el <slot>)
      const trigger = wrapper.firstElementChild as HTMLElement | null;
      const tooltip = wrapper.querySelector<HTMLElement>(".tooltip");
      const arrowElement = wrapper.querySelector<HTMLElement>(".tooltip-arrow");

      if (!trigger || !tooltip || !arrowElement) return;

      const placement = (tooltip.dataset.placement ?? "top") as Placement;
      const offsetValue = Number(tooltip.dataset.offset ?? 8);

      const transformOffset = { x: 0, y: 0 };

      function updatePosition() {
        if (!trigger || !tooltip || !arrowElement) return;

        computePosition(trigger, tooltip, {
          placement,
          middleware: [
            offsetMiddleware(offsetValue),
            flip(),
            shift({ padding: 8 }),
            arrow({ element: arrowElement }),
          ],
        }).then(({ x, y, placement: resolvedPlacement, middlewareData }) => {
          Object.assign(tooltip.style, {
            left: `${x}px`,
            top: `${y}px`,
          });

          const arrowData = middlewareData.arrow;
          if (arrowData) {
            if (arrowData.x != null)
              arrowElement.style.left = `${arrowData.x}px`;
            if (arrowData.y != null)
              arrowElement.style.top = `${arrowData.y}px`;
          }

          const basePlacement = resolvedPlacement.split("-")[0] as
            | "top"
            | "bottom"
            | "left"
            | "right";

          const sides = {
            top: "bottom",
            bottom: "top",
            left: "right",
            right: "left",
          };
          // Reset all sides first
          (["top", "bottom", "left", "right"] as const).forEach((s) => {
            arrowElement.style[s] = "";
          });
          (arrowElement.style as any)[sides[basePlacement]] = "-4px";
        });
      }

      function showTooltip() {
        updatePosition();
        gsap.killTweensOf(tooltip);
        gsap.to(tooltip, {
          opacity: 1,
          y: 0,
          duration: 0.2,
          ease: "power2.out",
        });
      }

      function hideTooltip() {
        gsap.killTweensOf(tooltip);
        gsap.to(tooltip, { opacity: 0, y: -4, duration: 0.15 });
      }

      trigger.addEventListener("mouseenter", showTooltip);
      trigger.addEventListener("mouseleave", hideTooltip);

      trigger.addEventListener("mousemove", (event: MouseEvent) => {
        const rect = trigger.getBoundingClientRect();
        const mouseX = event.clientX - rect.left - rect.width / 2;
        const mouseY = event.clientY - rect.top - rect.height / 2;

        gsap.to(transformOffset, {
          x: mouseX * 0.3,
          y: mouseY * 0.3,
          duration: 0.3,
          ease: "power2.out",
          onUpdate: () => {
            gsap.set(tooltip, { x: transformOffset.x, y: transformOffset.y });
          },
        });
      });

      autoUpdate(trigger, tooltip, updatePosition);
    });
  }

  // Inicializar en carga normal y tras navegación con View Transitions
  document.addEventListener("astro:page-load", initTooltips);
</script>
