---
// Carousel.astro
import { Icon } from "astro-icon/components";
import { dataCarousel } from "./data.ts";
---

<section>
  <div class="container-carousel opacity-0">
    <div class="carousel" aria-label="horizontal carousel of images">
      {
        dataCarousel.map((item) => (
          <div class="carousel-slide relative">
            <div class="carousel-slide-overlay absolute -top-[10%] -left-[10%] z-30 h-[120%] w-[120%] bg-black" />
            <img src={item.imgSrc} />
            <h2 class="text-center text-white">{item.title}</h2>
            <h5 class="text-center text-white">{item.subtitle}</h5>
          </div>
        ))
      }
    </div>

    <nav class="carousel-nav absolute bottom-4">
      <button
        class="prev inline-block cursor-pointer"
        tabindex="0"
        aria-label="Previous Slide"
      >
        <Icon name="left" class="h-16 w-16 rotate-90 text-white" />
      </button>
      <button
        class="next inline-block cursor-pointer"
        tabindex="0"
        aria-label="Next Slide"
      >
        <Icon name="right" class="h-16 w-16 -rotate-90 text-white" />
      </button>
      <div>1/8</div>
    </nav>
  </div>
</section>

<style>
  section {
    width: 100vw;
    min-height: calc(100vh + var(--header-height));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .inactive {
    pointer-events: none;
  }

  .active {
    z-index: 300;
  }

  .container-carousel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .carousel {
    width: 100vw;
    height: 70vh;
    gap: 5px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    display: flex;
    -webkit-overflow-scrolling: touch;
  }

  .carousel-slide {
    position: relative;
    flex: 0 0 75%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    scroll-snap-align: center;
    clip-path: inset(0);
    contain: paint;

    @media (width > 768px) {
      flex: 0 0 55%;
    }
  }

  .carousel-slide-overlay {
    pointer-events: none;
    transform-origin: top;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .carousel-slide img {
    position: absolute;
    left: 0;
    top: 0;
    width: 150%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .carousel-slide h2,
  .carousel-slide h5 {
    position: relative;
    z-index: 10;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.8);
    margin: 0;
    padding: 0;
  }

  .carousel-slide h2 {
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .carousel-slide h5 {
    font-size: clamp(1rem, 2.5vw, 2rem);
    font-weight: 300;
  }

  .carousel-nav {
    position: absolute;
    width: 95%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 310;
    @media (width >= 678px) {
      width: 65%;
    }
  }

  .prev {
    transform: rotate(-90deg);
  }

  .next {
    transform: rotate(90deg);
  }

  .carousel-nav div {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: #fff;
    font-weight: 200;
    opacity: 0.5;
    pointer-events: none;
    letter-spacing: 0.25rem;
    font-size: clamp(22px, 3.9vw, 44px);
  }

  ::-webkit-scrollbar {
    height: 13px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    border-top: 6px solid #000;
    background: #555;
    width: 50%;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: #bbb;
  }

  .carousel-nav button {
    transition: opacity 0.3s ease;
  }

  .carousel-nav button:hover {
    opacity: 0.4;
  }

  /* FIX: typo corregido — doble punto eliminado */
  .carousel-nav button svg,
  .carousel-nav button svg * {
    pointer-events: none;
  }
</style>

<script>
  import gsap from "gsap";
  import { Draggable } from "gsap/Draggable";
  import { InertiaPlugin } from "gsap/InertiaPlugin";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(Draggable, InertiaPlugin, CustomEase);

  CustomEase.create("smoothAnimation", "0.25, 0.1, 0.25, 1");

  interface CustomTimeline extends gsap.core.Timeline {
    toIndex: (
      index: number,
      vars?: gsap.TweenVars,
    ) => gsap.core.Timeline | gsap.core.Tween;
    closestIndex: (setCurrent?: boolean) => number;
    current: () => number;
    next: (vars?: gsap.TweenVars) => gsap.core.Timeline | gsap.core.Tween;
    previous: (vars?: gsap.TweenVars) => gsap.core.Timeline | gsap.core.Tween;
    times: number[];
    draggable?: any;
    _removeResize: () => void;
  }

  // FIX: referencia al cleanup para evitar memory leaks con View Transitions
  let cleanup: (() => void) | null = null;

  function init() {
    // Si ya había una instancia previa, limpiarla antes de crear una nueva
    if (cleanup) cleanup();

    const slides = gsap.utils.toArray<HTMLElement>(".carousel-slide");
    const prev = document.querySelector<HTMLButtonElement>(".prev")!;
    const next = document.querySelector<HTMLButtonElement>(".next")!;
    const carouselSlideOverlays = gsap.utils.toArray<HTMLElement>(
      ".carousel-slide-overlay",
    );
    const containerCarousel = document.querySelector(
      ".container-carousel",
    ) as HTMLDivElement;

    if (!slides.length) return;

    // FIX: índice del slide anterior para animar solo ese, en lugar de iterar todos
    let prevIndex = 0;

    gsap.to(containerCarousel, {
      duration: 1,
      ease: "power2.out",
      opacity: 1,
    });

    carouselSlideOverlays.forEach((overlay, i) => {
      gsap.to(overlay, {
        duration: 1.25,
        ease: "power2.inOut",
        yPercent: -100,
        delay: i * 0.2 + 0.5,
      });
    });

    // Override CSS to prevent native scrolling
    gsap.set(".carousel", { overflow: "visible", scrollSnapType: "none" });

    // Image parallax helper
    function slideImgUpdate() {
      slides.forEach((slide) => {
        const rect = slide.getBoundingClientRect();
        const prog = gsap.utils.mapRange(-rect.width, innerWidth, 0, 1, rect.x);
        const val = gsap.utils.clamp(0, 1, prog);
        const img = slide.querySelector<HTMLImageElement>("img");
        if (img) {
          gsap.set(img, {
            xPercent: gsap.utils.interpolate(-10, 10, val),
          });
        }
      });
    }

    interface HorizontalLoopConfig {
      paused?: boolean;
      paddingRight?: number;
      center?: boolean;
      draggable?: boolean;
      speed?: number;
      snap?: number | false;
      repeat?: number;
      reversed?: boolean;
      onChange?: (slide: HTMLElement, index: number) => void;
    }

    function horizontalLoop(
      items: HTMLElement[],
      config: HorizontalLoopConfig,
    ): CustomTimeline {
      items = gsap.utils.toArray<HTMLElement>(items);
      config = config || {};

      const onChange = config.onChange;
      let lastIndex = 0;
      let tl: CustomTimeline;

      tl = gsap.timeline({
        repeat: config.repeat,
        paused: config.paused,
        defaults: { ease: "none" },
        onUpdate: onChange
          ? function () {
              slideImgUpdate();
              const i = tl.closestIndex();
              if (lastIndex !== i) {
                lastIndex = i;
                onChange(items[i], i);
              }
            }
          : slideImgUpdate,
        onReverseComplete: () => {
          tl.totalTime(
            (tl.rawTime() as number) + (tl.duration() as number) * 100,
          );
        },
      }) as CustomTimeline;

      const length = items.length;
      const startX = items[0].offsetLeft;
      const times: number[] = [];
      const widths: number[] = [];
      const spaceBefore: number[] = [];
      const xPercents: number[] = [];
      let curIndex = 0;
      let indexIsDirty = false;
      const center = config.center;
      const pixelsPerSecond = (config.speed || 1) * 100;
      const snap =
        config.snap === false
          ? (v: number) => v
          : gsap.utils.snap(config.snap || 1);
      const container =
        center === true
          ? (items[0].parentNode as HTMLElement)
          : gsap.utils.toArray<HTMLElement>(center as any)[0] ||
            (items[0].parentNode as HTMLElement);
      let totalWidth: number;
      let timeOffset = 0;
      let timeWrap: (t: number) => number;
      let proxy: HTMLElement;

      const getTotalWidth = () => {
        const lastItem = items[length - 1];
        const scaleX = gsap.getProperty(lastItem, "scaleX") as number;
        const paddingRight = parseFloat(config.paddingRight as any) || 0;
        return (
          lastItem.offsetLeft +
          (xPercents[length - 1] / 100) * widths[length - 1] -
          startX +
          spaceBefore[0] +
          lastItem.offsetWidth * scaleX +
          paddingRight
        );
      };

      const populateWidths = () => {
        let b1 = container.getBoundingClientRect();
        let b2: DOMRect;
        items.forEach((el, i) => {
          widths[i] = parseFloat(gsap.getProperty(el, "width", "px") as string);
          const xPx = parseFloat(gsap.getProperty(el, "x", "px") as string);
          const currentXPercent = gsap.getProperty(el, "xPercent") as number;
          xPercents[i] = snap((xPx / widths[i]) * 100 + currentXPercent);
          b2 = el.getBoundingClientRect();
          spaceBefore[i] = b2.left - (i ? b1.right : b1.left);
          b1 = b2;
        });
        gsap.set(items, { xPercent: (i: number) => xPercents[i] });
        totalWidth = getTotalWidth();
      };

      const populateOffsets = () => {
        const duration = tl.duration() as number;
        timeOffset = center
          ? (duration * (container.offsetWidth / 2)) / totalWidth
          : 0;
        // FIX: guard redundante eliminado — times ya tiene contenido al llamarse tras populateTimeline
        times.forEach((t, i) => {
          times[i] = timeWrap(
            (tl.labels["label" + i] as number) +
              (duration * widths[i]) / 2 / totalWidth -
              timeOffset,
          );
        });
      };

      const getClosest = (values: number[], value: number, wrap: number) => {
        let i = values.length;
        let closest = 1e10;
        let index = 0;
        let d: number;
        while (i--) {
          d = Math.abs(values[i] - value);
          if (d > wrap / 2) d = wrap - d;
          if (d < closest) {
            closest = d;
            index = i;
          }
        }
        return index;
      };

      const populateTimeline = () => {
        let curX: number;
        let distanceToStart: number;
        let distanceToLoop: number;
        tl.clear();

        for (let i = 0; i < length; i++) {
          const item = items[i];
          curX = (xPercents[i] / 100) * widths[i];
          distanceToStart = item.offsetLeft + curX - startX + spaceBefore[0];
          const scaleX = gsap.getProperty(item, "scaleX") as number;
          distanceToLoop = distanceToStart + widths[i] * scaleX;

          tl.to(
            item,
            {
              xPercent: snap(((curX - distanceToLoop) / widths[i]) * 100),
              duration: distanceToLoop / pixelsPerSecond,
            },
            0,
          )
            .fromTo(
              item,
              {
                xPercent: snap(
                  ((curX - distanceToLoop + totalWidth) / widths[i]) * 100,
                ),
              },
              {
                xPercent: xPercents[i],
                duration:
                  (curX - distanceToLoop + totalWidth - curX) / pixelsPerSecond,
                immediateRender: false,
              },
              distanceToLoop / pixelsPerSecond,
            )
            .add("label" + i, distanceToStart / pixelsPerSecond);

          times[i] = distanceToStart / pixelsPerSecond;
        }
        timeWrap = gsap.utils.wrap(0, tl.duration() as number);
      };

      const refresh = (deep?: boolean) => {
        const progress = tl.progress();
        tl.progress(0, true);
        populateWidths();
        if (deep) populateTimeline();
        populateOffsets();
        if (deep && tl.draggable && tl.paused()) {
          tl.time(times[curIndex], true);
        } else {
          tl.progress(progress, true);
        }
      };

      // FIX: versión antigua comentada eliminada
      let resizeTimer: ReturnType<typeof setTimeout>;
      const onResize = () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          gsap.set(items, { scale: 1 });
          tl.progress(0, true);
          populateWidths();
          populateTimeline();
          populateOffsets();
          tl.toIndex(curIndex, { duration: 0 });
          gsap.set(items[curIndex], { scale: 1.2 });
        }, 150);
      };

      gsap.set(items, { x: 0 });
      populateWidths();
      populateTimeline();
      populateOffsets();
      window.addEventListener("resize", onResize);

      const toIndex = (
        index: number,
        vars?: gsap.TweenVars,
      ): gsap.core.Timeline | gsap.core.Tween => {
        vars = vars || {};
        if (Math.abs(index - curIndex) > length / 2) {
          index += index > curIndex ? -length : length;
        }
        const newIndex = gsap.utils.wrap(0, length, index);
        let time = times[newIndex];
        const currentTime = tl.time() as number;
        const duration = tl.duration() as number;

        if (time > currentTime !== index > curIndex && index !== curIndex) {
          time += duration * (index > curIndex ? 1 : -1);
        }
        if (time < 0 || time > duration) {
          vars.modifiers = { time: timeWrap };
        }
        curIndex = newIndex;
        vars.overwrite = true;
        gsap.killTweensOf(proxy);
        return vars.duration === 0
          ? (tl.time(timeWrap(time)) as gsap.core.Timeline)
          : tl.tweenTo(time, vars);
      };

      tl.toIndex = toIndex;
      tl.closestIndex = (setCurrent?: boolean) => {
        const index = getClosest(
          times,
          tl.time() as number,
          tl.duration() as number,
        );
        if (setCurrent) {
          curIndex = index;
          indexIsDirty = false;
        }
        return index;
      };
      tl.current = () => (indexIsDirty ? tl.closestIndex(true) : curIndex);
      tl.next = (vars?: gsap.TweenVars) => toIndex(tl.current() + 1, vars);
      tl.previous = (vars?: gsap.TweenVars) => toIndex(tl.current() - 1, vars);
      tl.times = times;
      tl.progress(1, true).progress(0, true);

      if (config.reversed) {
        tl.reverse();
      }

      if (config.draggable && typeof Draggable === "function") {
        proxy = document.createElement("div");
        const wrap = gsap.utils.wrap(0, 1);
        let ratio: number;
        let startProgress: number;
        let draggable: any;
        let lastSnap: number;
        let initChangeX: number;
        let wasPlaying: boolean;

        const align = () => {
          tl.progress(
            wrap(startProgress + (draggable.startX - draggable.x) * ratio),
          );
        };
        const syncIndex = () => {
          tl.closestIndex(true);
        };

        draggable = Draggable.create(proxy, {
          trigger: items[0].parentNode as HTMLElement,
          type: "x",
          onPressInit() {
            const x = this.x;
            gsap.killTweensOf(tl);
            wasPlaying = !tl.paused();
            tl.pause();
            startProgress = tl.progress();
            refresh();
            ratio = 1 / totalWidth;
            initChangeX = startProgress / -ratio - x;
            gsap.set(proxy, { x: startProgress / -ratio });
          },
          onDrag: align,
          onThrowUpdate: align,
          overshootTolerance: 0,
          inertia: true,
          snap(value: number) {
            if (Math.abs(startProgress / -ratio - this.x) < 10) {
              return lastSnap + initChangeX;
            }
            const duration = tl.duration() as number;
            const time = -(value * ratio) * duration;
            const wrappedTime = timeWrap(time);
            const snapTime = times[getClosest(times, wrappedTime, duration)];
            let dif = snapTime - wrappedTime;
            if (Math.abs(dif) > duration / 2) {
              dif += dif < 0 ? duration : -duration;
            }
            lastSnap = (time + dif) / duration / -ratio;
            return lastSnap;
          },
          onRelease() {
            syncIndex();
            if (draggable.isThrowing) indexIsDirty = true;
          },
          onThrowComplete() {
            syncIndex();
            if (wasPlaying) tl.play();
          },
        })[0];

        tl.draggable = draggable;
      }

      tl.closestIndex(true);
      lastIndex = curIndex;
      if (onChange) onChange(items[curIndex], curIndex);

      // Exponemos la función de limpieza del resize desde el timeline
      tl._removeResize = () => window.removeEventListener("resize", onResize);

      return tl;
    }

    // Create seamless horizontal loop
    const loop = horizontalLoop(slides, {
      paused: true,
      paddingRight: 5,
      center: true,
      draggable: true,
      onChange: (slide, index) => {
        // FIX: animamos solo el slide anterior en lugar de iterar todos
        const previousSlide = slides[prevIndex];
        if (previousSlide && previousSlide !== slide) {
          gsap.to(previousSlide, {
            opacity: 0.3,
            scale: 1,
            duration: 1,
            ease: "smoothAnimation",
            overwrite: "auto",
          });
          gsap.to(previousSlide.querySelectorAll("h2, h5"), {
            opacity: 0,
            duration: 0.4,
            ease: "power2.out",
            overwrite: "auto",
          });
          previousSlide.classList.remove("active");
        }

        prevIndex = index;
        slide.classList.add("active");

        const texts = slide.querySelectorAll("h2, h5");
        const counter =
          document.querySelector<HTMLElement>(".carousel-nav div");

        // FIX: timeline del contador simplificado con .add() para cambiar el texto
        gsap
          .timeline()
          .to(counter, { opacity: 0, duration: 0.2, overwrite: "auto" })
          .add(() => {
            if (counter) counter.textContent = `${index + 1}/${slides.length}`;
          })
          .to(counter, { opacity: 1, duration: 0.4, overwrite: "auto" })
          // Slide activo
          .to(
            slide,
            {
              opacity: 1,
              scale: 1.2,
              duration: 1,
              ease: "smoothAnimation",
              overwrite: "auto",
            },
            0,
          )
          // FIX: "smoothAnimation.out" no es válido → sustituido por "power2.out"
          .fromTo(
            texts,
            { opacity: 0, y: 25 },
            {
              opacity: 1,
              y: 0,
              duration: 1,
              ease: "power2.out",
              stagger: 0.15,
              overwrite: "auto",
            },
            0.2,
          );
      },
    });

    const lockButtons = () => {
      next.classList.add("inactive");
      prev.classList.add("inactive");
      setTimeout(() => {
        next.classList.remove("inactive");
        prev.classList.remove("inactive");
      }, 1000);
    };

    // FIX: handlers extraídos a variables para poder eliminarlos en cleanup
    const onNext = () => {
      if (next.classList.contains("inactive")) return;
      lockButtons();
      loop.next({ duration: 1, ease: "smoothAnimation" });
    };

    const onPrev = () => {
      if (prev.classList.contains("inactive")) return;
      lockButtons();
      loop.previous({ duration: 1, ease: "smoothAnimation" });
    };

    next.addEventListener("click", onNext);
    prev.addEventListener("click", onPrev);

    slides.forEach((slide, i) => {
      slide.addEventListener("click", () =>
        loop.toIndex(i, { duration: 1, ease: "smoothAnimation" }),
      );
    });

    gsap.set(".carousel-slide", {
      opacity: (i) => (i === 0 ? 1 : 0.3),
      scale: 1,
    });
    gsap.set(".carousel-slide h2", { opacity: (i) => (i === 0 ? 1 : 0) });
    gsap.set(".carousel-slide h5", { opacity: (i) => (i === 0 ? 1 : 0) });

    loop.toIndex(0, { duration: 0 });

    // FIX: cleanup completo — listeners de botones + resize + tweens activos
    cleanup = () => {
      next.removeEventListener("click", onNext);
      prev.removeEventListener("click", onPrev);
      loop._removeResize();
      gsap.killTweensOf([
        ...slides,
        ".carousel-nav div",
        ".container-carousel",
      ]);
      cleanup = null;
    };
  }

  // FIX: init solo una vez por navegación; cleanup antes de cada swap de página
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    if (cleanup) cleanup();
  });
</script>
