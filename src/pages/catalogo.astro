/* =========================
   FUNCIÓN PARA EXTRAER CATEGORÍAS
========================= */
function extraerTodasCategorias(row: RowODS): string[] {
  const categorias: string[] = [];

  // Combinar todas las categorías
  const todasLasCategorias = [
    ...categoriasConfig.produccion,
    ...categoriasConfig.guionDireccion,
    ...categoriasConfig.fotografiaIluminacion,
    ...categoriasConfig.maquillajePeluqueria,
    ...categoriasConfig.sonidoMusica,
    ...categoriasConfig.comunicacion,
    ...categoriasConfig.varios,
    ...categoriasConfig.empresas,
  ];

  todasLasCategorias.forEach((campo) => {
    const valor = row[campo];
    if (
      valor &&
      valor !== null &&
      valor.toString().trim() !== "" &&
      valor.toString().trim() !== "Elija una o varias opciones"
    ) {
      // Extraer el nombre de la categoría del campo entre corchetes
      const match = campo.match(/\[([^\]]+)\]/);
      if (match) {
        categorias.push(match[1]);
      }
    }
  });

  return categorias;
}

/* =========================
   NORMALIZACIÓN
========================= */
const catalogo: PersonaCatalogo[] = rows.map((row) => {
  const trabajosDestacados: Produccion[] = [];

  produccionesConfig.forEach((config) => {
    const titulo = row[config.titulo]?.toString().trim() ?? "";
    const tipo = row[config.tipo]?.toString().trim() ?? "";
    const cargo = row[config.cargo]?.toString().trim() ?? "";
    const pais = row[config.pais]?.toString().trim() ?? "";
    const urlTrailer = row[config.trailer]?.toString().trim() ?? "";
    const rawYear = row[config.anio];

    // Manejar el año como string o número
    let anio: string | number | null = null;
    if (rawYear !== null && rawYear !== undefined) {
      const yearStr = rawYear.toString().trim();
      if (yearStr !== "") {
        // Si es un número simple, convertir a número
        if (/^\d{4}$/.test(yearStr)) {
          anio = Number(yearStr);
        } else {
          // Si es un rango o texto, mantener como string
          anio = yearStr;
        }
      }
    }

    // Solo agregamos producciones que tengan al menos el título
    if (titulo) {
      trabajosDestacados.push({
        titulo,
        tipo,
        cargo,
        pais,
        anio,
        urlTrailer,
      });
    }
  });

  // Construir teléfonos
  const tel1 = row["Teléfono 1"]?.toString().trim() ?? "";
  const tel2 = row["Teléfono 2"]?.toString().trim() ?? "";
  const telefonos = [tel1, tel2].filter((t) => t !== "").join(" - ");

  // Redes sociales y web separados
  const redes = row["Redes Sociales"]?.toString().trim() ?? "";
  const web = row["Web"]?.toString().trim() ?? "";

  // Determinar tipo de registro (EMPRESAS o PROFESIONALES)
  const tipoRegistroRaw = row["EMPRESAS"]?.toString().trim() ?? "";
  const tipoRegistro =
    tipoRegistroRaw === "EMPRESAS" ? "EMPRESAS" : "PROFESIONALES";

  return {
    tipoRegistro,
    empresa: row["Nombre de la Empresa"]?.toString().trim() ?? "",
    categoriaEmpresa: extraerTodasCategorias(row),
    contacto: {
      nombre: row["Nombre y apellidos"]?.toString().trim() ?? "",
      email: row["E-mail"]?.toString().trim() ?? "",
      direccion: row["Dirección Postal"]?.toString().trim() ?? "",
      poblacion: row["Población"]?.toString().trim() ?? "",
      telefonos,
      redesSociales: redes,
      web,
    },
    trabajosDestacados,
  };
});

/* =========================
   GUARDAR JSON
========================= */
fs.writeFileSync(
  path.resolve("src/data/catalogo.json"),
  JSON.stringify(catalogo, null, 2),
  "utf-8",
);

const conTrabajos = catalogo.filter((p) => p.trabajosDestacados.length > 0);

const empresas = catalogo.filter((p) => p.tipoRegistro === "EMPRESAS");
const profesionales = catalogo.filter(
  (p) => p.tipoRegistro === "PROFESIONALES",
);
---

<h1>Catálogo normalizado completo</h1>
<pre>{JSON.stringify(catalogo, null, 2)}</pre>
