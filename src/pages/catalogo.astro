---
import Layout from "@/layouts/Layout.astro";
import { generarCatalogoJSON } from "@/lib/catalogue-generate";

const catalogo = generarCatalogoJSON();

console.log(catalogo);
---

<Layout title="Catálogo">
  <section class="mt-[calc(var(--header-height)+2rem)]">
    <h1 class="my-8">Guía de Recursos | Empresas</h1>
    <!-- <pre>{JSON.stringify(catalogo, null, 2)}</pre> -->
    <div
      class="catalogue mx-auto mb-16 flex w-[min(95%,480px)] flex-col gap-0.5 shadow-[0_3px_10px_rgb(0,0,0,0.2)]"
    >
      <div class="bg-ifef-dark rounded-t-lg py-4 text-center">
        <h2 class="text-light">Acron</h2>
        <h3 class="text-light text-base">
          Fotografía / Impresión gran formato
        </h3>
      </div>
      <div class="border-primary flex flex-col gap-y-4 border-t-6">
        <div>
          <div class="bg-film text-light mt-1 rounded-t-md px-2 py-1">
            Contacto
          </div>
          <div class="p-2">
            <div>Rafael Gonzalez Tierno</div>
            <div>Avda. Portugar 6, Cádiz</div>
            <div>652478521 - 687441325</div>
            <div>info@acron.es</div>
          </div>
        </div>
        <div>
          <div>Trabajos destacados</div>
          <div>
            <h4>Pediatría Hospital Puerta del Mar</h4>
            <p>Rodajes a bordo</p>
            <p>Cine, anuncios, etc</p>
            <p>España</p>
            <p>2021</p>
          </div>
          <div></div>
        </div>
        <div></div>
      </div>
    </div>
  </section>
</Layout>

