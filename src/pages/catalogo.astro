---
import Layout from "@/layouts/Layout.astro";
import { generarCatalogoJSON } from "@/lib/catalogue-generate";
import { Icon } from "astro-icon/components";

const catalogo = generarCatalogoJSON();

console.log(catalogo);
---

<Layout title="Catálogo">
  <section class="mt-[calc(var(--header-height)+2rem)] min-h-[400dvh]">
    <h1 class="my-8">Guía de Recursos | Empresas</h1>
    <!-- <pre>{JSON.stringify(catalogo, null, 2)}</pre> -->
    <div
      class="catalogue mx-auto mb-16 flex w-[min(95%,480px)] flex-col shadow-[0_3px_10px_rgb(0,0,0,0.2)]"
    >
      <div
        style="
    background-image: url('/svg/wave.svg');
    background-size: cover;
    background-position: bottom;
    background-repeat: no-repeat;
  "
        class="-dark rounded-t-lg py-10 text-center"
      >
        <h2 class="text-light">Acron</h2>
        <h3 class="text-light text-base">
          Fotografía / Impresión gran formato
        </h3>
      </div>
      <div class="border-primary flex flex-col border-t-6">
        <div>
          <div class="bg-ifef-dark text-light mt-1 rounded-t-md px-2 py-1">
            Contacto
          </div>
          <div class="flex flex-col px-4 py-2">
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span
                ><Icon name="person" class="text-primary h-5 w-5" />
              </span><p>Rafael Gonzalez Tierno</p>
            </div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="location" class="text-primary h-5 w-5" /></span
              ><p>Avda. Portugar 6, Cádiz</p>
            </div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="phone" class="text-primary h-5 w-5" /></span><p>
                652478521 - 687441325
              </p>
            </div>
            <div class="flex items-center gap-3 py-3">
              <span><Icon name="mail" class="text-primary h-5 w-5" /></span><p>
                info@acron.es
              </p>
            </div>
          </div>
        </div>
        <div>
          <div class="bg-ifef-dark text-light mt-1 rounded-t-md px-2 py-1">
            Trabajos destacados
          </div>
          <div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="tag" class="text-primary h-5 w-5" /></span><h4>
                Rodajes a bordo
              </h4>
            </div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="puzzle" class="text-primary h-5 w-5" /></span><p
              >
                Cine, anuncios, etc
              </p>
            </div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="globe" class="text-primary h-5 w-5" /></span><p>
                España
              </p>
            </div>
            <div
              class="border-primary/25 flex items-center gap-3 border-b-1 py-3"
            >
              <span><Icon name="calendar" class="text-primary h-5 w-5" /></span
              ><p>2021</p>
            </div>
          </div>
          <div></div>
        </div>
        <div></div>
      </div>
    </div>
  </section>
</Layout>

