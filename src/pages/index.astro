---
import Tooltip from "@/components/Tooltip.astro";
import Slider from "@/components/slider/Slider.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Inicio">
  <Slider />

  <div class="container-cards">
    <section class="intro">
      <h1 class="text-dark">Every idea begins as a single image</h1>
    </section>
    <section class="sticky" id="sticky">
      <div class="sticky-header">
        <h1>Three pillars with one purpose</h1>
      </div>
      <div class="card-container max-[1000px]:space-y-4">
        <div class="card" id="card-1">
          <div class="card-front">
            <img
              src="https://i.ibb.co/4wShfg0B/image-part-001.jpg"
              alt="image part 001"
            />
          </div>
          <div class="card-back">
            <span>01</span>
            <p>Interactive Web Experiences</p>
          </div>
        </div>
        <div class="card" id="card-2">
          <div class="card-front">
            <img
              src="https://i.ibb.co/Y4MSmLXB/image-part-002.jpg"
              alt="image part 002"
            />
          </div>
          <div class="card-back">
            <span>02</span>
            <p>Thoughtful Design Language</p>
          </div>
        </div>
        <div class="card" id="card-3">
          <div class="card-front">
            <img
              src="https://i.ibb.co/NkrBdsq/image-part-003.jpg"
              alt="image part 003"
            />
          </div>
          <div class="card-back">
            <span>03</span>
            <p>Visual Design Systems</p>
          </div>
        </div>
      </div>
    </section>
    <section class="outro">
      <h1>Every transition leaves a trace</h1>
    </section>
  </div>
</Layout>

<style>
  img {
    width: 100%;
    height: 100%;
    object-fit: fill;
  }

  section {
    position: relative;
    width: 100%;
    height: 100svh;
    padding: 2rem;
    color: var(--fg);
  }

  .intro,
  .outro {
    text-align: center;
    align-content: center;
  }

  .sticky {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .sticky-header {
    position: absolute;
    width: 100%;
    top: 20%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .sticky-header h1 {
    position: relative;
    text-align: center;
    will-change: transform, opacity;
    transform: translateY(40px);
    opacity: 0;
  }

  .card-container {
    position: relative;
    width: 75%;
    display: flex;
    perspective: 1000px;
    transform: translateY(40px);
    will-change: width;
  }

  .card {
    position: relative;
    flex: 1;
    aspect-ratio: 5 / 7;
    transform-style: preserve-3d;
    transform-origin: top;
  }

  #card-1 {
    border-radius: 20px 0 0 20px;
  }

  #card-3 {
    border-radius: 0 20px 20px 0;
  }

  .card-front,
  .card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    border-radius: inherit;
    overflow: hidden;
  }

  .card-back {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    transform: rotateY(180deg);
    padding: 1.5rem;
    border-radius: 3.59281% / 2.58621%;
    color: black;
    @media (width > 768px) {
      padding: 2rem;
    }
    @media (width > 1000px) {
      padding: 1.5rem;
    }
  }

  .card-back span {
    position: absolute;
    top: 1.5rem;
    left: 1.5rem;
    opacity: 0.5;
    font-size: 2rem;
    @media (width > 400px) {
      font-size: 3rem;
      top: 1.5rem;
      left: 1.5rem;
    }
    @media (width > 768px) {
      font-size: 4rem;
      top: 2rem;
      left: 2rem;
    }

    @media (width > 1000px) {
      font-size: 2rem;
      top: 1rem;
      left: 1rem;
    }
  }

  #card-1 .card-back {
    background: linear-gradient(
      165.825deg,
      color-mix(in srgb, var(--card-1) 90%, black) 0%,
      color-mix(in srgb, var(--card-1) 60%, black) 100%
    );
  }

  #card-2 .card-back {
    background: linear-gradient(
      177deg,
      color-mix(in srgb, var(--card-2) 100%, white) -18%,
      color-mix(in srgb, var(--card-2) 80%, black) 31%,
      color-mix(in srgb, var(--card-2) 50%, black) 100%
    );
  }

  #card-3 .card-back {
    background: linear-gradient(
      color-mix(in srgb, var(--card-3) 100%, white) 0%,
      color-mix(in srgb, var(--card-3) 60%, black) 100%
    );
  }

  @media (max-width: 1000px) {
    h1 {
      font-size: 3rem;
    }

    .intro h1,
    .outro h1 {
      width: 100%;
    }

    .sticky {
      height: max-content;
      padding: 4rem 2rem;
      flex-direction: column;
    }

    .sticky-header {
      position: relative;
      top: 0;
      left: 0;
      transform: none;
      margin-bottom: 4rem;
    }

    .sticky-header h1 {
      opacity: 1;
    }

    .card-container {
      width: 100%;
      flex-direction: column;
      gap: 1rem !important;
    }

    .card {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
      border-radius: 20px !important;
    }

    #card-1,
    #card-2,
    #card-3,
    .card-back {
      transform: none;
    }
  }
  .container-cards {
    position: relative;
    &:after {
      content: "";
      position: absolute;
      top: 0;
      left: 20%;
      height: 1px;
      width: 60%;
      background-color: rgba(var(--color-dark-rgb), 0.25);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", () => {
    // ✅ Limpiamos instancias anteriores antes de crear nuevas
    ScrollTrigger.getAll().forEach((st) => st.kill());

    const mm = gsap.matchMedia();

    mm.add("(min-width: 1000px)", () => {
      const masterTl = gsap.timeline({
        scrollTrigger: {
          trigger: ".sticky",
          start: "top top",
          end: "+=400%",
          scrub: 1,
          pin: true,
          markers: false,
        },
      });

      masterTl
        .fromTo(
          ".sticky-header h1",
          { y: 40, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.25 },
          0.1,
        )
        .to(".card-container", { width: "60%", duration: 0.35 }, 0)
        .to(".card-container", { gap: 30, duration: 0.1 }, 0.45)
        .to("#card-1", { x: -30, borderRadius: "20px", duration: 0.1 }, 0.45)
        .to("#card-3", { x: 30, borderRadius: "20px", duration: 0.1 }, 0.45)
        .to("#card-2", { borderRadius: "20px", duration: 0.1 }, 0.45)
        .to(
          ".card",
          {
            rotationY: 180,
            duration: 0.15,
            stagger: 0.03,
            ease: "power2.inOut",
          },
          0.7,
        )
        .to(
          ["#card-1", "#card-3"],
          {
            y: 30,
            rotationZ: (i: number) => (i === 0 ? -15 : 15),
            duration: 0.15,
            ease: "power2.inOut",
          },
          0.7,
        );

      // ✅ Devolvemos la función de cleanup para cuando Astro desmonte la página
      return () => {
        mm.revert();
      };
    });

    let resizeTimer: number;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        ScrollTrigger.refresh();
      }, 220);
    });
  });
</script>
