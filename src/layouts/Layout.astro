---
import "../styles/global.css";
import Header from "@/components/header/Header.astro";
import MobileMenu from "@/components/header/MobileMenu.astro";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Cádiz Film Office: Tu puerta de entrada para rodar en la provincia gaditana. Gestionamos permisos, localizaciones y logística para producciones audiovisuales en playas, pueblos blancos y ciudades históricas",
  image = "",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/svg/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Cádiz FilmOffice</title>
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-headings" preload />
  </head>
  <ClientRouter />
  <body>
    <Header />
    <div id="visual-layer">
      <main id="page-content">
        <slot />
      </main>
    </div>


  </body>

  <style>
    html,
    body {
      margin: 0;
      width: 100%;
      height: 100%;
    }
  </style>

  <script>
    import Lenis from "lenis";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    declare global {
      interface Window {
        lenis?: Lenis;
      }
    }

    document.addEventListener("astro:page-load", () => {
      let isHeaderHovered = false;

      const horizontalBarMenu = document.querySelector(
        ".horizontal-bar-menu",
      ) as HTMLDivElement;
      type State = "animate-up" | "animate-down";
      const lenis = new Lenis();
      // Guardar instancia en window para acceso global
      if (typeof window !== "undefined") {
        // Usar type assertion para evitar el error de TypeScript
        window.lenis = lenis;
      }

      const header = document.querySelector("#main-header");

      lenis.on("scroll", (e) => {
        if (!header) return;
        if (isHeaderHovered) return;

        const position = e.animatedScroll;
        const direction = e.direction;

        ScrollTrigger.update();

        gsap.killTweensOf(horizontalBarMenu);

        if (position > 0 && direction > 0) {
          gsap.to(horizontalBarMenu, {
            width: 80,
            duration: 0.5,
          });
          updateState("animate-up");
        } else {
          const targetWidth = Math.min(window.innerWidth * 0.35, 200);

          gsap.to(horizontalBarMenu, {
            width: targetWidth,
            duration: 0.5,
          });
          updateState("animate-down");
        }
      });

      // Sincronizar con GSAP ticker
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);

      function updateState(state: State) {
        const states = ["animate-up", "animate-down"] as const;
        states.forEach((stateClass) => header?.classList.remove(stateClass));
        header?.classList.add(state);
      }

      header?.addEventListener("mouseenter", () => {
        isHeaderHovered = true;

        gsap.killTweensOf(horizontalBarMenu);

        updateState("animate-down");
        const targetWidth = Math.min(window.innerWidth * 0.35, 200);

        gsap.to(horizontalBarMenu, {
          width: targetWidth,
          duration: 0.5,
        });
      });

      header?.addEventListener("mouseleave", () => {
        isHeaderHovered = false;
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    });
  </script>
</html>
